# ============================================================
# Variables de entorno — dashboard-partners (Next.js)
# Copia este archivo a .env.local y rellena los valores.
# En Vercel TODAS deben existir: el código nuevo NO tiene fallbacks
# hardcodeados (a diferencia del legacy).
# ============================================================

# --- Browser (NEXT_PUBLIC_) ---
# Proyecto admin de Supabase (clients_config, user_profiles, reviews, kommo_*).
# El anon key es público por diseño.
NEXT_PUBLIC_ADMIN_SUPABASE_URL=
NEXT_PUBLIC_ADMIN_SUPABASE_ANON_KEY=

# --- Server (route handlers) ---
ADMIN_SUPABASE_URL=              # mismo proyecto admin (lado servidor)
SUPABASE_ANON_KEY=               # anon key del proyecto admin (lado servidor)
ADMIN_SUPABASE_SERVICE_KEY=      # service key admin (scrape-reviews, kommo) — bypass RLS
SUPABASE_URL=                    # proyecto per-cliente: /api/leads/ingest (qualified_leads) y /api/leads/list (Panel Director)
SUPABASE_SECRET_KEY=             # service key (sb_secret_…) del proyecto per-cliente — /api/leads/list, bypass RLS, solo server
AIRTABLE_TOKEN=                  # token Airtable (reservations/create)
ANTHROPIC_API_KEY=               # Claude (análisis de sentimiento en scrape-reviews)
BRIGHT_DATA_API_TOKEN=           # Bright Data (scrapers de reviews)
LEADS_INGEST_SECRET=             # Bearer que usa n8n para POST /api/leads/ingest
KOMMO_WEBHOOK_SECRET=            # X-Webhook-Secret para /api/kommo/heartbeat
CRON_SECRET=                     # protege GET /api/scrape-reviews y /api/kommo/sweep
SLACK_DEFAULT_WEBHOOK_URL=       # fallback de webhook Slack para alertas kommo
